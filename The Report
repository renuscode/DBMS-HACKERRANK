SELECT 
    CASE 
        WHEN g.grade BETWEEN 8 AND 10 THEN s.name
        ELSE 'NULL'
    END AS Name,
    g.grade AS Grade,
    s.marks AS Marks
FROM Students s
JOIN Grades g ON s.marks BETWEEN g.min_mark AND g.max_mark
ORDER BY 
    g.grade DESC,
    CASE 
        WHEN g.grade BETWEEN 8 AND 10 THEN s.name
        ELSE NULL
    END ASC,
    CASE 
        WHEN g.grade NOT BETWEEN 8 AND 10 THEN s.marks
        ELSE NULL
    END ASC;
